# Copy to .env. Never commit .env or share it.
# Local demo may use an empty password. REQUIRED for Tuya and server deployment.
APP_PASSWORD=
# Optional persistent session signing secret, at least 32 random characters.
# If empty, a new secret is generated at startup (all logins expire on restart).
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Tuya Developer Platform cloud project credentials (backend only).
# eu / us / cn / in / we / ea / sg. Must match the project's data center.
TUYA_REGION=eu
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Linked Smart Life / Tuya Smart app user UID, as shown in the cloud project.
TUYA_UID=
# Alternative to UID: comma-separated authorized device IDs.
TUYA_DEVICE_IDS=
TUYA_POLL_SECONDS=15

# Only for compose.internet.yaml; use your actual DNS hostname, without https://.
# MONITOR_DOMAIN=power.your-domain.com

# Empty/omitted -> data/monitor.db, SQLite. For PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://monitor:password@localhost:5432/tuya
